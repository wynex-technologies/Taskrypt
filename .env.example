# TASKRYPT environment template — copy to `.env` (development) and never commit real values.
#
# Only PUBLIC values belong here. Everything prefixed EXPO_PUBLIC_ is inlined into the
# JavaScript bundle and can be read by anyone who has the app binary.
# NEVER put the Supabase service-role key, database password or JWT secret in this file.

# Supabase project URL (Project Settings → API).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key. Safe to ship ONLY because every table and bucket
# is protected by Row Level Security (see supabase/migrations).
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Private storage bucket that holds document binaries.
EXPO_PUBLIC_DOCUMENT_BUCKET=vault

# Maximum upload size in megabytes. Must be <= the bucket file_size_limit on the server.
EXPO_PUBLIC_MAX_UPLOAD_MB=50

# How many days the app may be opened offline after the last successful online sign-in.
EXPO_PUBLIC_OFFLINE_GRACE_DAYS=14

# Redirect URL used in Supabase auth emails (must be added to Auth → URL Configuration).
EXPO_PUBLIC_AUTH_REDIRECT_URL=taskrypt://auth/callback

# development | staging | production
EXPO_PUBLIC_APP_ENV=development
